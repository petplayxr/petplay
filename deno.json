{
  "workspace": [
    "./submodules/threewebxrwebgpudeno"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["deno.window", "deno.unstable", "dom", "dom.iterable"]
  },
  "nodeModulesDir": "auto",
  // A single npm three for the app and every npm consumer (r3f peer, gainmap-js, iwer devui);
  // keep in step with the `three` imports below.
  "overrides": { "three": "0.186.1" },
  "imports": {
    "@gfx/dwm": "jsr:@gfx/dwm@^0.3.9",
    "@milly/namedpipe": "jsr:@milly/namedpipe@^1.1.0",
    "@mommysgoodpuppy/logchannel": "jsr:@mommysgoodpuppy/logchannel@^0.1.0",
    "@denosaurs/byte-type": "https://raw.githubusercontent.com/mommysgoodpuppy/byte_type_C/main/mod.ts",
    "@std/path": "jsr:@std/path@^1.1.4",
    //pmdrs
    "@pmndrs/xr": "./submodules/threewebxrwebgpudeno/submodules/xr/packages/react/xr/src/index.ts",
    "@pmndrs/handle": "./submodules/threewebxrwebgpudeno/submodules/xr/packages/handle/src/index.ts",
    "@pmndrs/pointer-events": "./submodules/threewebxrwebgpudeno/submodules/xr/packages/pointer-events/src/index.ts",
    //r3f
    "@react-three/fiber": "./classes/r3fWebgpuCompat.ts",
    "@react-three/fiber/webgpu": "./classes/r3fWebgpuCompat.ts",
    "@react-three/handle": "./submodules/threewebxrwebgpudeno/submodules/xr/packages/react/handle/src/index.ts",
    "pngjs": "npm:pngjs@^7.0.0",
    "react": "npm:react@^19.2.5",
    "@types/react": "npm:@types/react@^19.2.14",
    "react-dom": "npm:react-dom@^19.2.5",
    //three.js
    "three": "npm:three@0.186.1/webgpu",
    "three/webgpu": "npm:three@0.186.1/webgpu",
    "three/addons/": "npm:/three@0.186.1/examples/jsm/",
    "three/tsl": "npm:three@0.186.1/tsl",
    "https://cdn.jsdelivr.net/gh/mrdoob/three.js@dev/": "npm:/three@0.186.1/",
    "@types/three": "npm:@types/three@^0.186.0",
    "@win32/km": "https://raw.githubusercontent.com/DjDeveloperr/deno_win32/refs/heads/main/api/UI/Input/KeyboardAndMouse.ts"
  },
  "tasks": {
    "preconf": "deno run -A utils/preconf.ts",
    "nulldriver:true": "deno run -A utils/null-driver-toggle.ts true",
    "nulldriver:false": "deno run -A utils/null-driver-toggle.ts false",
    "driver:build": "zig build --build-file submodules/petplay_ovrdriver/build.zig",
    "driver:test": "deno run -A utils/petplay-ovrdriver-test.ts --build",
    "overlay:presenter:build": "deno run -A utils/build-overlay-presenter.ts",
    "openvr:probe": "deno run -A utils/openvr-timing-probe.ts",
    "probe:openvr-raylib-overlay": "deno run -A --no-check tests/openvr_raylib_overlay_probe/main.ts",
    "probe:openvr-raylib-overlay:build-native": "clang-cl /nologo /LD /O2 /Fo:tests/openvr_raylib_overlay_probe/native_timing.obj tests/openvr_raylib_overlay_probe/native_timing.c /link /out:tests/openvr_raylib_overlay_probe/native_timing.dll /implib:tests/openvr_raylib_overlay_probe/native_timing.lib",
    "probe:openvr-compositor-timing": "deno run -A --no-check tests/openvr_compositor_timing_probe/main.ts",
    "audio:probe": "deno run -A utils/raylib-audio-context-probe.ts",
    "repro:raylib-reload": "deno run -A --no-check tests/raylib_worker_reload_repro/main.ts",
    "cefbuild": "cd submodules/cefpuppy && deno run -A build.ts -ExampleName cefsimple -Profile release",
    "iwerbuild": "cd submodules/threewebxrwebgpudeno/submodules/iwer && npm run build",
    "check": "deno run -A utils/type-check.ts",
    "check:all": "deno check --allow-import",
    "ui": "deno run -A petplay/uiViewer.tsx ",
    "server": "deno run -A --unstable-webgpu --env-file --no-check petplay/petplay.ts dev --agent-repl --openvr-reattach",
    "status": "deno run -A petplay/client.ts status",
    "reboot": "deno run -A petplay/client.ts reboot",
    "desktop": "deno run -A petplay/client.ts desktop",
    "client": "deno run -A petplay/client.ts ",
    "overlay:perf": "deno run -A utils/overlay-perf.ts --launch",
    "playtest": "deno run -A utils/playtest-run.ts",
    "vrlab": "deno run -A --no-check utils/vrlab.ts",
    "vrlab:camera-check": "deno run -A --no-check utils/vrlab-camera-check.ts",
    "keyb": "deno run -A petplay/keyboardViewer.tsx ",
    "keyb:reset": "deno run -A petplay/resetKeyboard.ts",
    "build:raylib": "deno run -A utils/build-raylib.ts",
    "build:native": "deno run -A utils/build-native.ts",
    "build:webxr": "cd submodules/threewebxrwebgpudeno/submodules/iwer && pnpm install --frozen-lockfile --filter iwer... --ignore-scripts && pnpm run build",
    "build": {
      "command": "deno run -A utils/build.ts"
    },
    "devw": {
      "command": "deno run -A --env-file utils/watcher.ts --watch ./petplay/ --ext ts --verbose --exec \"deno run -A petplay/petplay.ts dev --openvr-reattach\"",
      "dependencies": [
        "cefbuild"
      ]
    },
    "app": {
      "command": "deno run -A utils/dev-runner.ts",
      "dependencies": [
        //"iwerbuild"
      ]
    },
    "dev": {
      "command": "deno run -A petplay/client.ts dev",
      "dependencies": [
        //"iwerbuild"
      ]
    },
    "dev:network": {
      "command": "deno task server -- --stageforge-networking"
    },
    "dev:novr": {
      "command": "deno run -A --unstable-webgpu --env-file --no-check petplay/petplay.ts dev --novr",
      "dependencies": [
        //"iwerbuild"
      ]
    },
    "install:dev": "deno run -A utils/dev-install.ts install",
    "uninstall:dev": "deno run -A utils/dev-install.ts uninstall",
    "dev:status": "deno run -A utils/dev-install.ts status",
    "dev:steamvr": "deno run -A --env-file utils/steamvr-watch.ts",
    "steamvr:register": "deno run -A utils/steamvr-app.ts register",
    "steamvr:unregister": "deno run -A utils/steamvr-app.ts unregister",
    "steamvr:status": "deno run -A utils/steamvr-app.ts status",
    "dev:desktop": {
      "command": "deno run -A --unstable-webgpu --env-file --no-check petplay/petplay.ts dev --novr --desktop",
      "dependencies": [
        //"iwerbuild"
      ]
    }
  },
  "unstable": [
    "net",
    "worker-options",
    "sloppy-imports"
  ],
  "fmt": {
    "semiColons": true,
    "indentWidth": 2,
    "lineWidth": 100,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-unused-vars",
        "no-inner-declarations"
      ]
    }
  },
  "exclude": [
    "_scratch/",
    "tmp/",
    "submodules/",
    "dist/",
    "submodules/threewebxrwebgpudeno/submodules/"
  ],
  "scopes": {
    "./submodules/threewebxrwebgpudeno/": {
      "iwer": "./submodules/threewebxrwebgpudeno/submodules/iwer/packages/iwer/src/index.ts",
      "iwer/": "./submodules/threewebxrwebgpudeno/submodules/iwer/packages/iwer/src/",
      "iwer/lib/device/XRDevice": "./submodules/threewebxrwebgpudeno/submodules/iwer/packages/iwer/src/device/XRDevice.ts"
    }
  }
}

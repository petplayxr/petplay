# Baked into cross-built release executables, which leave the developer .env out.
# Without these, React and the rest of the npm stack load their development builds.
NODE_ENV="production"
DENO_CONDITIONS="production"
# LogChannel prints only listed channels (default: "default"). These carry the supervisor, overlay
# host, capture and WebXR lifecycle lines the per-run log file needs for bug reports.
LOG_CHANNELS="default,actor,webxrv2,webxrhost,screencap"

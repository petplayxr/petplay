{
  "action_manifest_version": 0,
  "alias_info": {},
  "bindings": {
    "/actions/main": {
      "haptics": [
        {
          "output": "/actions/main/out/Haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/main/out/Haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "poses": [
        {
          "output": "/actions/main/in/HandPoseLeft",
          "path": "/user/hand/left/pose/raw"
        },
        {
          "output": "/actions/main/in/HandPoseRight",
          "path": "/user/hand/right/pose/raw"
        }
      ],
      "sources": [
        {
          "inputs": {
            "click": {
              "output": "/actions/main/in/TriggerLeft"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/left/input/trigger",
          "parameters": {
            "click_activate_threshold": "0.55",
            "click_deactivate_threshold": "0.45"
          }
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/main/in/TriggerRight"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/right/input/trigger",
          "parameters": {
            "click_activate_threshold": "0.55",
            "click_deactivate_threshold": "0.45"
          }
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/main/in/GrabLeft"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/left/input/squeeze",
          "parameters": {
            "click_activate_threshold": "0.55",
            "click_deactivate_threshold": "0.45"
          }
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/main/in/GrabRight"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/right/input/squeeze",
          "parameters": {
            "click_activate_threshold": "0.55",
            "click_deactivate_threshold": "0.45"
          }
        },
        {
          "inputs": {
            "touch": {
              "output": "/actions/main/in/RightClickModifier"
            }
          },
          "mode": "button",
          "path": "/user/hand/left/input/primary"
        },
        {
          "inputs": {
            "touch": {
              "output": "/actions/main/in/RightClickModifier"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/primary"
        },
        {
          "inputs": {
            "touch": {
              "output": "/actions/main/in/MiddleClickModifier"
            }
          },
          "mode": "button",
          "path": "/user/hand/left/input/secondary"
        },
        {
          "inputs": {
            "touch": {
              "output": "/actions/main/in/MiddleClickModifier"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/secondary"
        },
        {
          "inputs": {
            "position": {
              "output": "/actions/main/in/JoystickLeft"
            }
          },
          "mode": "joystick",
          "path": "/user/hand/left/input/thumbstick"
        },
        {
          "inputs": {
            "position": {
              "output": "/actions/main/in/JoystickRight"
            }
          },
          "mode": "joystick",
          "path": "/user/hand/right/input/thumbstick"
        }
      ]
    }
  },
  "category": "steamvr_input",
  "controller_type": "droidframe_quest",
  "description": "Quest controllers through the DroidFrame OpenVR bridge",
  "name": "DroidFrame Quest",
  "options": {},
  "simulated_actions": []
}
